<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock_barcode.LineTitle" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_product_label')]" position="after">
            <div t-if="line.sin_stock" class="o_sin_stock_badge">
                SIN STOCK EN <t t-esc="line.location_id.display_name"/>
            </div>
        </xpath>
    </t>

    <!-- En los renglones sin stock el destino confunde: se oculta. -->
    <t t-inherit="stock_barcode.LineDestinationLocation" t-inherit-mode="extension">
        <xpath expr="//div[@name='destination_location']" position="attributes">
            <attribute name="t-if">displayDestinationLocation and !line.sin_stock</attribute>
        </xpath>
    </t>
</templates>
